APP_ENV=development
DATABASE_URL=postgresql+psycopg://memoryhub:memoryhub@localhost:5432/memoryhub
JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
OTP_PEPPER=replace-with-a-separate-long-random-secret
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
FRONTEND_ORIGINS=http://localhost:3000
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
EMAIL_BACKEND=smtp
EMAIL_FROM=no-reply@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
PROVIDER_ENCRYPTION_KEY=replace-with-a-fernet-key
CHROMA_PATH=./data/chroma
KIE_API_KEY=your-kie-api-key
MEMORY_RETRIEVAL_LIMIT=8
LOG_LEVEL=INFO

# Production (Render) values for the deployed AI Memory Hub:
# APP_ENV=production
# FRONTEND_ORIGINS=https://ai-memory-hub-phi.vercel.app
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none
# COOKIE_DOMAIN=
# GOOGLE_OAUTH_REDIRECT_URI=https://ai-memory-hub-api.onrender.com/api/v1/auth/google/callback
#
# Leave COOKIE_DOMAIN blank. The backend intentionally creates host-only OAuth
# and session cookies so a Vercel domain cannot invalidate them.

